{
    "name": "upantelic/meta-seo",
    "description": "A powerful Laravel meta tag manager for SEO, Open Graph, and Twitter Cards with automatic synchronization and fallback support.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "MetaSeo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MetaSeo\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Uros Pantelic",
            "email": "urospantelic196@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0|^12.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "MetaSeo\\MetaSeoServiceProvider"
            ],
            "aliases": {
                "Meta": "MetaSeo\\Facade\\Meta"
            }
        }
    }
}
